  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx,js,jsx}",
      "!src/**/*.test.{ts,tsx,js,jsx}",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts",
      "!src/**/testData/**",
      "!src/**/types/**",
